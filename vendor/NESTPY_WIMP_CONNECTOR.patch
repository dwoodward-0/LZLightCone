+// Expose samples and their matching native preparation metadata. The NEST
+// spectrum, reference cross-section, RNG, and normalization are unchanged.
+py::dict fill_wimp_with_metadata(int number, double mass, double eStep, double day) {
+	if (number < 0) {
+		throw py::value_error("number must be non-negative");
+	}
+	auto ws = TestSpectra::WIMP_prep_spectrum(mass, eStep, day);
+	py::array_t<double> samples(number);
+	auto out = samples.mutable_unchecked<1>();
+	for (int i = 0; i < number; ++i) {
+		out(i) = TestSpectra::WIMP_spectrum(ws, mass, day);
+	}
+	return py::dict(
+		"samples"_a = samples,
+		"integral"_a = ws.integral,
+		"xMax"_a = ws.xMax,
+		"divisor"_a = ws.divisor,
+		"mass"_a = mass,
+		"eStep"_a = eStep,
+		"day"_a = day
+	);
+}
